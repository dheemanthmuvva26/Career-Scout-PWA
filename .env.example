# Copy this file to .env and fill in real values
# Never commit .env to git

# Groq API (free tier) — get from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Shared API key — the PWA, n8n, and any other client must send this as the
# X-API-Key header on every request except /health and /resumes/*.
API_KEY=your_shared_api_key_here

# Postgres connection string (Supabase or any Postgres). If unset, falls
# back to a local SQLite file.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Web Push (proactive notifications: digest, scout results, follow-up
# nudges). Generate a key pair once with py_vapid:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); ..."
# VAPID_PRIVATE_KEY is base64-encoded PEM (kept single-line for .env). The
# frontend fetches VAPID_PUBLIC_KEY at runtime via GET /push/vapid-public-key,
# so it doesn't need its own copy in pwa/.env.local.
VAPID_PRIVATE_KEY=your_base64_encoded_private_key_pem_here
VAPID_PUBLIC_KEY=your_base64url_public_key_here
VAPID_CLAIM_EMAIL=mailto:you@example.com

# Gmail job-alert import (LinkedIn / Naukri / Indeed / Internshala alert
# emails -> jobs). Uses IMAP, read-only. Create an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Not an OAuth token on purpose: Google expires OAuth refresh tokens for
# unverified apps every 7 days; App Passwords don't expire.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Google Sheets spreadsheet ID (from the sheet URL)
# URL format: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# n8n API key — for import_workflows.py
# Get from: http://localhost:5678 -> Settings -> API -> Create an API key
N8N_API_KEY=your_n8n_api_key_here
