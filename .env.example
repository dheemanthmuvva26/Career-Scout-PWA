# Copy this file to .env and fill in real values
# Never commit .env to git

# Groq API (free tier) — get from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheets spreadsheet ID (from the sheet URL)
# URL format: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# n8n API key — for import_workflows.py
# Get from: http://localhost:5678 -> Settings -> API -> Create an API key
N8N_API_KEY=your_n8n_api_key_here
