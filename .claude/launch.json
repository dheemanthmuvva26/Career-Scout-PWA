{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "career-scout-pwa",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-H", "0.0.0.0"],
      "port": 3000,
      "cwd": "pwa"
    },
    {
      "name": "api-local",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "pwa-local-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3000"],
      "port": 3000,
      "cwd": "pwa",
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:8000" }
    }
  ]
}
