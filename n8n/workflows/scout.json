{
  "name": "scout",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "id": "trigger-schedule",
      "name": "Every 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/scout",
        "options": { "timeout": 10000 }
      },
      "id": "trigger-scout",
      "name": "Trigger Scout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "amount": 300,
        "unit": "seconds"
      },
      "id": "wait-for-pipeline",
      "name": "Wait 5min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/scout/last",
        "options": {}
      },
      "id": "get-summary",
      "name": "Get Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/jobs?status=new&min_score=3.5&limit=10",
        "options": {}
      },
      "id": "get-new-jobs",
      "name": "Get New Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ $json.length }}", "operation": "larger", "value2": 0 }]
        }
      },
      "id": "check-jobs",
      "name": "Has New Jobs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔍 *Scout run complete*\n\nFound: {{ $('Get Summary').item.json.raw_scraped }} raw\nNew: {{ $('Get Summary').item.json.inserted }}\nMerged: {{ $('Get Summary').item.json.merged }}\nScored: {{ $('Get Summary').item.json.scored }}\n\n{{ $json.length > 0 ? '🆕 *Top matches (score ≥ 3.5):*' : 'No new matches above threshold.' }}\n{{ $json.map(j => `${ j.urgency === 'hot' ? '🔴' : '🟡' } *${j.title}* @ ${j.company}\\n   ⭐ ${j.score?.toFixed(1)}  📍 ${j.location || '?'}\\n   ID: \\`${j.id}\\``).join('\\n\\n') }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "send-alert",
      "name": "Send Job Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1560, 200],
      "credentials": { "telegramApi": { "id": "1", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ ($('Get Summary').item.json.health_alerts || []).length }}", "operation": "larger", "value2": 0 }]
        }
      },
      "id": "check-health",
      "name": "Health Alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 500]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ *Scraper health alerts:*\n{{ $('Get Summary').item.json.health_alerts.join('\\n') }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "send-health-alert",
      "name": "Send Health Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1560, 500],
      "credentials": { "telegramApi": { "id": "1", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Every 6h":       { "main": [[{ "node": "Trigger Scout",    "type": "main", "index": 0 }]] },
    "Trigger Scout":  { "main": [[{ "node": "Wait 5min",        "type": "main", "index": 0 }]] },
    "Wait 5min":      { "main": [[{ "node": "Get Summary",      "type": "main", "index": 0 }]] },
    "Get Summary":    { "main": [[{ "node": "Get New Jobs",     "type": "main", "index": 0 }, { "node": "Check Health",  "type": "main", "index": 0 }]] },
    "Get New Jobs":   { "main": [[{ "node": "Has New Jobs?",    "type": "main", "index": 0 }]] },
    "Has New Jobs?":  { "main": [[{ "node": "Send Job Alert",   "type": "main", "index": 0 }], []] },
    "Health Alerts?": { "main": [[{ "node": "Send Health Alert","type": "main", "index": 0 }], []] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "career-scout" }]
}
