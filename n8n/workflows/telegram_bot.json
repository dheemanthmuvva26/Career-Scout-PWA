    "Unknown Command":    { "main": [[{ "node": "Merge Responses",     "type": "main", "index": 0 }]] },
    "Format Jobs":        { "main": [[{ "node": "Merge Responses",     "type": "main", "index": 0 }]] },
    "Format Job Detail":  { "main": [[{ "node": "Merge Responses",     "type": "main", "index": 0 }]] },
    "Format Apply":       { "main": [[{ "node": "Merge Responses",     "type": "main", "index": 0 }]] },
