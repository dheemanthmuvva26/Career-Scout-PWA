{
  "name": "followup",
  "nodes": [
    {
      "id": "trigger-followup",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "position": [200, 300],
      "typeVersion": 1.1
    },
    {
      "id": "get-followups",
      "name": "GET /followups",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/followups",
        "responseFormat": "json"
      },
      "position": [440, 300],
      "typeVersion": 4.2
    },
    {
      "id": "auto-ghost",
      "name": "POST /followups/auto-ghost",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/followups/auto-ghost",
        "responseFormat": "json"
      },
      "position": [680, 300],
      "typeVersion": 4.2
    },
    {
      "id": "notify-ghosted",
      "name": "Notify Ghosted",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const ghosted = $json.ghosted || [];\nconst messages = [];\nfor (const j of ghosted) {\n  messages.push({ text: `👻 Auto-marked as ghosted (14 days, no update):\\n*${j.title}* @ ${j.company}\\nJob ID: ${j.id}` });\n}\nif (ghosted.length === 0) {\n  return [];\n}\nreturn messages.map(m => ({ json: m }));"
      },
      "position": [920, 300],
      "typeVersion": 2
    },
    {
      "id": "send-ghost-telegram",
      "name": "Send Ghost Notifications",
      "type": "n8n-nodes-base.telegram",
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "position": [1160, 300],
      "typeVersion": 1.1,
      "credentials": { "telegramApi": { "id": "telegram-creds", "name": "Telegram" } }
    },
    {
      "id": "split-nudges",
      "name": "Split Nudge List",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": { "batchSize": 1 },
      "position": [440, 500],
      "typeVersion": 3
    },
    {
      "id": "format-nudge",
      "name": "Format Nudge Message",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const j = $json;\nconst due = j.follow_up_due ? j.follow_up_due.substring(0, 10) : '?';\nreturn [{ json: {\n  text: `⏰ *Follow-up due:* ${j.title} @ ${j.company}\\nApplied on: ${due}\\n\\nUpdate status:\\n/interview ${j.id}  |  /rejected ${j.id}  |  /ghosted ${j.id}`\n}}];"
      },
      "position": [680, 500],
      "typeVersion": 2
    },
    {
      "id": "send-nudge-telegram",
      "name": "Send Follow-up Nudge",
      "type": "n8n-nodes-base.telegram",
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "position": [920, 500],
      "typeVersion": 1.1,
      "credentials": { "telegramApi": { "id": "telegram-creds", "name": "Telegram" } }
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [[ { "node": "GET /followups", "type": "main", "index": 0 } ]]
    },
    "GET /followups": {
      "main": [[
        { "node": "POST /followups/auto-ghost", "type": "main", "index": 0 },
        { "node": "Split Nudge List",           "type": "main", "index": 0 }
      ]]
    },
    "POST /followups/auto-ghost": {
      "main": [[ { "node": "Notify Ghosted", "type": "main", "index": 0 } ]]
    },
    "Notify Ghosted": {
      "main": [[ { "node": "Send Ghost Notifications", "type": "main", "index": 0 } ]]
    },
    "Split Nudge List": {
      "main": [[ { "node": "Format Nudge Message", "type": "main", "index": 0 } ]]
    },
    "Format Nudge Message": {
      "main": [[ { "node": "Send Follow-up Nudge", "type": "main", "index": 0 } ]]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
