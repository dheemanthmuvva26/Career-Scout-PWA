{
  "name": "morning_digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        },
        "timezone": "Asia/Kolkata"
      },
      "id": "trigger-cron",
      "name": "8am IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/jobs?status=new&min_score=3.5&limit=5",
        "options": {}
      },
      "id": "get-jobs",
      "name": "Get Hot/Active Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/stats",
        "options": {}
      },
      "id": "get-stats",
      "name": "Get Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 500]
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ $('Get Hot/Active Jobs').item.json.length }}", "operation": "larger", "value2": 0 }]
        }
      },
      "id": "check-jobs",
      "name": "Has Jobs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=☀️ *Good morning, Dheemanth!*\n\n📊 Pipeline: {{ $('Get Stats').item.json.new }} new  |  {{ $('Get Stats').item.json.applied }} applied  |  {{ $('Get Stats').item.json.interviews }} interviews\n\n🆕 *Top matches since yesterday (score ≥ 3.5):*\n{{ $('Get Hot/Active Jobs').item.json.filter(j => ['hot','active'].includes(j.urgency)).slice(0,5).map(j => `${ j.urgency === 'hot' ? '🔴' : '🟡' } *${j.title}* @ ${j.company}\\n   ⭐ ${j.score?.toFixed(1)}  📍 ${j.location || '?'}\\n   ID: \\`${j.id}\\``).join('\\n\\n') }}\n\nReply /jobs for full list",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "send-digest",
      "name": "Send Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [940, 300],
      "credentials": { "telegramApi": { "id": "1", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "8am IST":            { "main": [[{ "node": "Get Hot/Active Jobs", "type": "main", "index": 0 }, { "node": "Get Stats", "type": "main", "index": 0 }]] },
    "Get Hot/Active Jobs": { "main": [[{ "node": "Has Jobs?",          "type": "main", "index": 0 }]] },
    "Has Jobs?":          { "main": [[{ "node": "Send Digest",         "type": "main", "index": 0 }], []] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "career-scout" }]
}
